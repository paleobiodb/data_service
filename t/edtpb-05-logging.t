use strict;

use lib 't', '../lib', 'lib';
use Test::More tests => 9;

use File::Temp qw(tempdir);
use Data::Dumper;

use TableDefs qw(%TABLE set_table_property);

use EDTPBTest;
use PBDBTester;
use EditTester qw(ok_new_edt ok_commit ok_failed_commit clear_table sql_command);


# Establish the tester and select the test tables.

my $T = PBDBTester->new('EDTPBTest');

EDTPBTest->select_test_tables;


# The test users are identified by the session ids 'SESSION-AUTHORIZER', 'SESSION-ENTERER',
# etc. SUPERUSER is person 39999, and ENTERER is enterer 39997 with authorizer 39998.

sub perm {
    
    my ($name, $table) = @_;
    
    return $T->new_perm("SESSION-$name", $table || 'EDTPB_MAIN');
}


# Set or clear a property of the specified table, and clear the table cache so that the
# change takes effect.

sub set_property {
    
    my ($table, $property, $value) = @_;
    
    set_table_property($table => $property => $value);
    EDTPBTest->clear_table_cache($table);
}


# Execute the specified code with the log file set to a file in a temporary directory, and
# LOG_ALL_TABLES set to the specified value. Return the contents of the log, or the empty
# string if nothing was written.

sub with_logging {
    
    my ($log_all, $code) = @_;
    
    my $logdir = tempdir(CLEANUP => 1);
    my $logfile = "$logdir/edtpb-05.log";
    
    my $save_filename = EDTPBTest->log_filename;
    my $save_all = EDTPBTest->log_all_tables;
    
    EDTPBTest->log_filename($logfile);
    EDTPBTest->log_all_tables($log_all);
    
    eval { $code->() };
    my $error = $@;
    
    EDTPBTest->log_filename($save_filename);
    EDTPBTest->log_all_tables($save_all);
    
    die $error if $error;
    
    my $log = '';
    
    if ( open(my $fh, '<', $logfile) )
    {
	local $/;
	$log = <$fh>;
    }
    
    return $log;
}


# Split a log into events. Each event is a hashref with the fields of the header line, the
# reversing statement (with the hashmarks removed), and the logged statement.

sub log_events {
    
    my ($log) = @_;
    
    my @events;
    
    foreach my $line ( split /\n/, $log )
    {
	if ( $line =~ /^# (\d\d\d\d-\d\d-\d\d \d\d:\d\d:\d\d) \| (.*)/ )
	{
	    my ($op, $table, $key, $auth_no, $ent_no) = split / \| /, $2;
	    push @events, { op => $op, table => $table, key => $key, auth_no => $auth_no,
			    ent_no => $ent_no, rev => '', sql => '' };
	}
	
	elsif ( @events && $events[-1]{sql} eq '' && $line =~ /^# ?(.*)/ )
	{
	    $events[-1]{rev} .= ($events[-1]{rev} ne '' ? "\n" : '') . $1;
	}
	
	elsif ( @events )
	{
	    $events[-1]{sql} .= ($events[-1]{sql} ne '' ? "\n" : '') . $line;
	}
    }
    
    return @events;
}


# Return the contents of the specified table as a list of hashrefs ordered by the
# specified key.

sub table_contents {
    
    my ($table, $key) = @_;
    
    return $T->dbh->selectall_arrayref("SELECT * FROM $TABLE{$table} ORDER BY $key",
				       { Slice => { } });
}


# Return a string representing the specified rows, for comparison.

sub dump_rows {
    
    local $Data::Dumper::Sortkeys = 1;
    
    return Data::Dumper::Dumper($_[0]);
}


# Set up the test records.

subtest 'setup' => sub {
    
    set_property('EDTPB_MAIN', LOG_CHANGES => 1);
    
    clear_table('EDTPB_MAIN');
    clear_table('EDTPB_OPEN');
    
    sql_command("INSERT INTO <<EDTPB_MAIN>> (main_no, authorizer_no, enterer_no, string_req,
		 string_val, updated) VALUES
		 (1, 39998, 39997, 'one', 'first', '2020-01-01 00:00:00'),
		 (2, 39998, 39997, 'two', 'second', NULL),
		 (3, 39998, 39997, 'three', 'third', NULL),
		 (4, 39998, 39997, 'four', 'fourth', NULL)");
    
    sql_command("INSERT INTO <<EDTPB_OPEN>> (open_no, string_val) VALUES (1, 'open')");
};


# Check the log output for each kind of operation.

subtest 'log_event' => sub {
    
    my $log = with_logging(0, sub {
	
	my $edt = ok_new_edt(permission => perm('SUPERUSER'), 'INSERT_KEY');
	
	$edt->insert_record('EDTPB_MAIN', { string_req => 'new' });
	$edt->update_record('EDTPB_MAIN', { main_no => 1, string_req => 'changed' });
	$edt->replace_record('EDTPB_MAIN', { main_no => 2, string_req => 'replaced' });
	$edt->replace_record('EDTPB_MAIN', { main_no => 20, string_req => 'replaced new' });
	$edt->delete_record('EDTPB_MAIN', '3,4');
	
	ok_commit("the transaction commits");
    });
    
    my @events = log_events($log);
    
    is( scalar(@events), 5, "one event is logged for each action" );
    
    is_deeply( [ map { $_->{op} } @events ], [ qw(INSERT UPDATE REPLACE INSERT DELETE) ],
	       "each event has the right operation" );
    
    is( $events[0]{table}, $TABLE{EDTPB_MAIN}, "the header contains the table name" );
    
    is_deeply( [ $events[0]{auth_no}, $events[0]{ent_no} ], [ 39999, 39999 ],
	       "the header contains the authorizer and enterer" );
    
    like( $events[0]{key}, qr/^\d+$/, "an insert is logged with the new key value" );
    
    like( $events[0]{rev}, qr/^DELETE FROM \S+ WHERE main_no in \('$events[0]{key}'\)$/,
	  "an insert is reversed by deleting the new record" );
    
    like( $events[1]{rev}, qr/^REPLACE INTO \S+ \(main_no,.*\) VALUES \('1',.*'one'/,
	  "an update is reversed by putting back the old record" );
    
    like( $events[1]{rev}, qr/'2020-01-01 00:00:00'/, "the old values are included" );
    
    like( $events[2]{rev}, qr/'two'.*,NULL\)$/, "NULL values are included" );
    
    like( $events[3]{rev}, qr/^DELETE FROM \S+ WHERE main_no in \('20'\)$/,
	  "replacing a record that did not exist is logged as an insert, reversed by deleting it" );
    
    is( $events[4]{key}, '3,4', "a delete of two records lists both keys" );
    
    like( $events[4]{rev}, qr/VALUES \('3',.*'three'.*\), \('4',.*'four'.*\)$/,
	  "a delete of two records is reversed by putting both back" );
    
    like( $events[1]{sql}, qr/^UPDATE .*\sWHERE main_no in \('1'\);$/s,
	  "the logged statement ends with a semicolon" );
};


# Check that the reversing statements actually reverse the transaction.

subtest 'reversing a transaction' => sub {
    
    my $before = table_contents('EDTPB_MAIN', 'main_no');
    
    my $log = with_logging(0, sub {
	
	my $edt = ok_new_edt(permission => perm('SUPERUSER'), 'INSERT_KEY');
	
	$edt->insert_record('EDTPB_MAIN', { main_no => 30, string_req => 'thirty' });
	$edt->update_record('EDTPB_MAIN', { main_no => 1, string_val => "two\nlines" });
	$edt->replace_record('EDTPB_MAIN', { main_no => 2, string_req => 'replaced again' });
	$edt->delete_record('EDTPB_MAIN', 20);
	
	ok_commit("the transaction commits");
    });
    
    isnt( dump_rows(table_contents('EDTPB_MAIN', 'main_no')), dump_rows($before),
	  "the table was changed" );
    
    my @events = log_events($log);
    
    is( scalar(grep { $_->{rev} } @events), 4, "every event has a reversing statement" );
    
    foreach my $event ( reverse @events )
    {
	$T->dbh->do($event->{rev});
    }
    
    is_deeply( table_contents('EDTPB_MAIN', 'main_no'), $before,
	       "executing the reversing statements in reverse order restores the table" );
};


# Check statements executed by 'do_sql'.

subtest 'do_sql' => sub {
    
    my $log = with_logging(0, sub {
	
	my $edt = ok_new_edt(permission => perm('SUPERUSER'));
	
	$edt->do_sql("UPDATE <<EDTPB_OPEN>> SET string_val = 'by sql'");
	
	ok_commit("the transaction commits");
    });
    
    my @events = log_events($log);
    
    is( scalar(@events), 1, "a statement executed by do_sql is logged" );
    
    is_deeply( [ @{$events[0]}{qw(op table key rev)} ], [ 'SQL', '-', '-', '' ],
	       "it is logged with no table and no reversing statement" );
    
    like( $events[0]{sql}, qr/SET string_val = 'by sql';$/, "the statement is logged" );
};


# Check which tables and transactions are logged.

subtest 'what is logged' => sub {
    
    my $log = with_logging(0, sub {
	my $edt = ok_new_edt(permission => perm('SUPERUSER'));
	$edt->update_record('EDTPB_OPEN', { open_no => 1, string_val => 'not logged' });
	ok_commit;
    });
    
    is( $log, '', "a table without LOG_CHANGES is not logged" );
    
    $log = with_logging(1, sub {
	my $edt = ok_new_edt(permission => perm('SUPERUSER'));
	$edt->update_record('EDTPB_OPEN', { open_no => 1, string_val => 'logged' });
	ok_commit;
    });
    
    my @events = log_events($log);
    
    is( scalar(@events), 1, "a table without LOG_CHANGES is logged with LOG_ALL_TABLES" );
    
    like( $events[0]{rev}, qr/^REPLACE INTO .* VALUES \('1','not logged'\)$/,
	  "the event has a reversing statement" );
    
    set_property('EDTPB_OPEN', NO_LOG => 1);
    
    $log = with_logging(1, sub {
	my $edt = ok_new_edt(permission => perm('SUPERUSER'));
	$edt->update_record('EDTPB_OPEN', { open_no => 1, string_val => 'no log' });
	ok_commit;
    });
    
    set_property('EDTPB_OPEN', NO_LOG => 0);
    
    is( $log, '', "a table with NO_LOG is not logged even with LOG_ALL_TABLES" );
    
    $log = with_logging(0, sub {
	my $edt = ok_new_edt(permission => perm('SUPERUSER'), 'NO_LOG_MODE');
	$edt->update_record('EDTPB_MAIN', { main_no => 1, string_req => 'no log mode' });
	ok_commit;
    });
    
    is( $log, '', "NO_LOG_MODE prevents logging" );
    
    $log = with_logging(0, sub {
	my $edt = ok_new_edt(permission => perm('SUPERUSER'));
	$edt->update_record('EDTPB_MAIN', { main_no => 1, string_req => 'failed' });
	$edt->add_condition('E_EXECUTE', 'test error');
	ok_failed_commit;
    });
    
    is( $log, '', "a transaction that fails is not logged" );
};


# Check log_aux_event, which is called by client modules to log changes to auxiliary tables.

subtest 'log_aux_event' => sub {
    
    my $edt = ok_new_edt(permission => perm('ENTERER'));
    
    my $log_lines = sub {
	my ($code) = @_;
	$edt->{log_lines} = '';
	with_logging(0, $code);
	return $edt->{log_lines};
    };
    
    # A reversing statement given as a string has every line commented out.
    
    my $lines = $log_lines->(sub {
	$edt->log_aux_event('delete', 'EDTPB_MAIN', "  DELETE FROM x\n\tWHERE main_no = 1",
			    'main_no = 1', "INSERT INTO x\nVALUES (1)\n");
    });
    
    my @events = log_events($lines);
    
    is( scalar(@events), 1, "the event is logged" );
    
    is_deeply( [ @{$events[0]}{qw(op table key auth_no ent_no)} ],
	       [ 'DELETE', $TABLE{EDTPB_MAIN}, 'main_no = 1', 39998, 39997 ],
	       "the header has the operation, table, key expression, authorizer, and enterer" );
    
    like( $lines, qr/^# INSERT INTO x\n# VALUES \(1\)\nDELETE FROM x\n/m,
	  "every line of the reversing statement is commented out" );
    
    like( $lines, qr/WHERE main_no = 1;\n$/, "the logged statement ends with a semicolon" );
    
    # A reversing statement given as a list of records puts them back, with NULL values
    # included.
    
    $lines = $log_lines->(sub {
	$edt->log_aux_event('delete', 'EDTPB_MAIN', "DELETE FROM x;", 'main_no = 5',
			    [ { main_no => 5, string_req => 'five', updated => undef } ]);
    });
    
    @events = log_events($lines);
    
    my @columns = $edt->table_column_list('EDTPB_MAIN');
    my ($cols, $vals) = $events[0]{rev} =~ /^REPLACE INTO \S+ \((.*)\) VALUES \((.*)\)$/;
    
    is( scalar(split /,/, $vals), scalar(@columns),
	"the reversing statement has a value for every column" );
    
    like( $vals, qr/^'5',NULL,.*'five'.*,NULL$/, "undefined values are given as NULL" );
    
    like( $lines, qr/^DELETE FROM x;\n$/m, "a statement that already ends with a semicolon gets only one" );
    
    # An empty list or no reversing statement adds no comment.
    
    $lines = $log_lines->(sub {
	$edt->log_aux_event('insert', 'EDTPB_MAIN', "INSERT INTO x", 'main_no = 6', [ ]);
	$edt->log_aux_event('insert', 'EDTPB_MAIN', "INSERT INTO x");
    });
    
    @events = log_events($lines);
    
    is_deeply( [ map { $_->{rev} } @events ], [ '', '' ], "no reversing statement is written" );
    
    is( $events[1]{key}, '?', "a missing key expression is shown as '?'" );
    
    # A table without LOG_CHANGES is not logged, unless LOG_ALL_TABLES is set.
    
    $lines = $log_lines->(sub {
	$edt->log_aux_event('insert', 'EDTPB_OPEN', "INSERT INTO x", 'open_no = 1');
    });
    
    is( $lines, '', "a table without LOG_CHANGES is not logged" );
    
    $edt->{log_lines} = '';
    with_logging(1, sub {
	$edt->log_aux_event('insert', 'EDTPB_OPEN', "INSERT INTO x", 'open_no = 1');
    });
    
    like( $edt->{log_lines}, qr/INSERT INTO x;/, "it is logged with LOG_ALL_TABLES" );
    
    $edt->{log_lines} = '';
};


# Check that changes made through 'do_logged_stmt' during a transaction are written to the
# log when it commits.

subtest 'do_logged_stmt' => sub {
    
    my $log = with_logging(0, sub {
	
	my $edt = ok_new_edt(permission => perm('SUPERUSER'));
	
	$edt->start_execution;
	
	$edt->do_logged_stmt('update', 'EDTPB_MAIN',
			     "UPDATE $TABLE{EDTPB_MAIN} SET int_val = 7 WHERE main_no = 1",
			     'main_no = 1',
			     "UPDATE $TABLE{EDTPB_MAIN} SET int_val = 0\nWHERE main_no = 1");
	
	ok_commit("the transaction commits");
    });
    
    my @events = log_events($log);
    
    is( scalar(@events), 1, "the statement is logged" );
    
    is( $events[0]{rev}, "UPDATE $TABLE{EDTPB_MAIN} SET int_val = 0\nWHERE main_no = 1",
	"the reversing statement is written as a comment" );
    
    like( $events[0]{sql}, qr/SET int_val = 7 WHERE main_no = 1;$/, "the statement is logged" );
};


# Check the methods that check the permission object passed to a new transaction.

subtest 'instance permission' => sub {
    
    my $perm = perm('ENTERER');
    
    ok( EDTPBTest->check_instance_permission($perm), "a Permissions object is accepted" );
    
    ok( ! EDTPBTest->check_instance_permission({ enterer_no => 1 }),
	"an unblessed hash is not accepted" );
    
    ok( ! EDTPBTest->check_instance_permission(bless { }, 'Other'),
	"an object of another class is not accepted" );
    
    is( EDTPBTest->validate_instance_permission($perm), $perm,
	"validate_instance_permission returns the Permissions object" );
    
    eval { EDTPBTest->validate_instance_permission({ enterer_no => 1 }) };
    
    like( $@, qr/must provide an object of class 'Permissions'/,
	  "validate_instance_permission throws an exception for anything else" );
};


# Remove the test properties.

subtest 'cleanup' => sub {
    
    set_property('EDTPB_MAIN', LOG_CHANGES => 0);
    
    ok( 1, "the LOG_CHANGES property was cleared" );
};
