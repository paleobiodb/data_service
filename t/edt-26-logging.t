use strict;

use lib 't', '../lib', 'lib';
use Test::More tests => 4;

use File::Temp qw(tempdir);

use ETBasicTest;
use EditTester qw(ok_new_edt ok_commit clear_table sql_command);

use TableDefs qw(%TABLE);


# Establish an EditTester instance.

my $T = EditTester->new('ETBasicTest');


# Execute the specified code with logging turned on, writing to a temporary file. Return
# the contents of the log.

sub with_logging {
    
    my ($code) = @_;
    
    my $logdir = tempdir(CLEANUP => 1);
    my $logfile = "$logdir/edt-26.log";
    
    my $save_filename = ETBasicTest->log_filename;
    my $save_all = ETBasicTest->log_all_tables;
    
    ETBasicTest->log_filename($logfile);
    ETBasicTest->log_all_tables(1);
    
    eval { $code->() };
    my $error = $@;
    
    ETBasicTest->log_filename($save_filename);
    ETBasicTest->log_all_tables($save_all);
    
    die $error if $error;
    
    my $log = '';
    
    if ( open(my $fh, '<', $logfile) )
    {
	local $/;
	$log = <$fh>;
    }
    
    return $log;
}


# Check that the necessary methods are defined.

subtest 'required methods' => sub {
    
    can_ok('ETBasicTest', 'log_filename', 'log_all_tables', 'log_event', 'quoted_table_name')
	
	|| BAIL_OUT "EditTransaction and related modules are missing some required methods";
};


# Check that each log entry names the table that was modified. The header lines use the
# bare table name, while the logged statements use the backquoted name.

subtest 'table names in the log' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six')");
    
    my $table_name = $TABLE{EDT_TEST};
    my $quoted_name = ETBasicTest->quoted_table_name('EDT_TEST');
    
    my $log = with_logging( sub {
	
	my $edt = ok_new_edt;
	
	$edt->insert_record('EDT_TEST', { string_req => 'logged insert' });
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'logged update' });
	$edt->delete_record('EDT_TEST', 6);
	
	ok_commit;
    });
    
    like( $log, qr/^# [^|]+ \| INSERT \| \Q$table_name\E \| \d+$/m,
	  "insert header names the table" );
    like( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| 5$/m,
	  "update header names the table" );
    like( $log, qr/^# [^|]+ \| DELETE \| \Q$table_name\E \| 6$/m,
	  "delete header names the table" );
    
    like( $log, qr/^INSERT INTO \Q$quoted_name\E \(/m, "insert statement uses the backquoted table name" );
    like( $log, qr/^UPDATE \Q$quoted_name\E SET/m, "update statement uses the backquoted table name" );
    like( $log, qr/^DELETE FROM \Q$quoted_name\E WHERE/m, "delete statement uses the backquoted table name" );
    
    unlike( $log, qr/^#.*`/m, "header lines contain no backquotes" );
};


# Check the key values in the log header lines. An action with more than one key value
# lists all of them, and an action selected by a _where expression has no key values
# and is logged with '?'.

subtest 'key values in the log' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six'), (7, 'seven')");
    
    my $table_name = $TABLE{EDT_TEST};
    
    my $log = with_logging( sub {
	
	my $edt = ok_new_edt;
	
	$edt->update_record('EDT_TEST', { _primary => '5,6', string_val => 'multiple' });
	$edt->update_record('EDT_TEST', { _where => "string_req = 'seven'", string_val => 'where' });
	
	ok_commit;
    });
    
    like( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| 5,6$/m,
	  "update with two key values lists both" );
    like( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| \?$/m,
	  "update selected by _where is logged with '?'" );
    unlike( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| $/m,
	    "no header line has an empty key value" );
};


# Check that before_log_event is passed the operation of each action that is logged.

subtest 'before_log_event' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six')");
    
    my @operations;
    
    no warnings 'redefine';
    
    local *ETBasicTest::before_log_event = sub {
	my ($edt, $action, $operation, $table_specifier) = @_;
	push @operations, "$operation $table_specifier";
    };
    
    with_logging( sub {
	
	my $edt = ok_new_edt;
	
	$edt->insert_record('EDT_TEST', { string_req => 'logged insert' });
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'logged update' });
	$edt->replace_record('EDT_TEST', { test_no => 5, string_req => 'logged replace' });
	$edt->delete_record('EDT_TEST', 6);
	
	ok_commit;
    });
    
    is_deeply( \@operations, [ 'insert EDT_TEST', 'update EDT_TEST', 'replace EDT_TEST',
			       'delete EDT_TEST' ],
	       "before_log_event is passed the operation of each action" );
};
