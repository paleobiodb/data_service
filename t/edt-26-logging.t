use strict;

use lib 't', '../lib', 'lib';
use Test::More tests => 6;

use File::Temp qw(tempdir);

use ETBasicTest;
use EditTester qw(ok_new_edt ok_commit ok_failed_commit clear_table sql_command);

use TableDefs qw(%TABLE set_table_property);


# Establish an EditTester instance.

my $T = EditTester->new('ETBasicTest');


# Execute the specified code with logging turned on, writing to a temporary file. Return
# the contents of the log.

sub with_logging {
    
    my ($code) = @_;
    
    my $logdir = tempdir(CLEANUP => 1);
    my $logfile = "$logdir/edt-26.log";
    
    my $save_filename = ETBasicTest->log_filename;
    my $save_all = ETBasicTest->log_all_tables;
    
    ETBasicTest->log_filename($logfile);
    ETBasicTest->log_all_tables(1);
    
    eval { $code->() };
    my $error = $@;
    
    ETBasicTest->log_filename($save_filename);
    ETBasicTest->log_all_tables($save_all);
    
    die $error if $error;
    
    my $log = '';
    
    if ( open(my $fh, '<', $logfile) )
    {
	local $/;
	$log = <$fh>;
    }
    
    return $log;
}


# Check that the necessary methods are defined.

subtest 'required methods' => sub {
    
    can_ok('ETBasicTest', 'log_filename', 'log_all_tables', 'log_event', 'quoted_table_name')
	
	|| BAIL_OUT "EditTransaction and related modules are missing some required methods";
};


# Check that each log entry names the table that was modified. The header lines use the
# bare table name, while the logged statements use the backquoted name.

subtest 'table names in the log' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six')");
    
    my $table_name = $TABLE{EDT_TEST};
    my $quoted_name = ETBasicTest->quoted_table_name('EDT_TEST');
    
    my $log = with_logging( sub {
	
	my $edt = ok_new_edt;
	
	$edt->insert_record('EDT_TEST', { string_req => 'logged insert' });
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'logged update' });
	$edt->delete_record('EDT_TEST', 6);
	
	ok_commit;
    });
    
    like( $log, qr/^# [^|]+ \| INSERT \| \Q$table_name\E \| \d+$/m,
	  "insert header names the table" );
    like( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| 5$/m,
	  "update header names the table" );
    like( $log, qr/^# [^|]+ \| DELETE \| \Q$table_name\E \| 6$/m,
	  "delete header names the table" );
    
    like( $log, qr/^INSERT INTO \Q$quoted_name\E \(/m, "insert statement uses the backquoted table name" );
    like( $log, qr/^UPDATE \Q$quoted_name\E SET/m, "update statement uses the backquoted table name" );
    like( $log, qr/^DELETE FROM \Q$quoted_name\E WHERE/m, "delete statement uses the backquoted table name" );
    
    unlike( $log, qr/^#.*`/m, "header lines contain no backquotes" );
};


# Check the key values in the log header lines. An action with more than one key value
# lists all of them, and an action selected by a _where expression has no key values
# and is logged with '?'.

subtest 'key values in the log' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six'), (7, 'seven')");
    
    my $table_name = $TABLE{EDT_TEST};
    
    my $log = with_logging( sub {
	
	my $edt = ok_new_edt;
	
	$edt->update_record('EDT_TEST', { _primary => '5,6', string_val => 'multiple' });
	$edt->update_record('EDT_TEST', { _where => "string_req = 'seven'", string_val => 'where' });
	
	ok_commit;
    });
    
    like( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| 5,6$/m,
	  "update with two key values lists both" );
    like( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| \?$/m,
	  "update selected by _where is logged with '?'" );
    unlike( $log, qr/^# [^|]+ \| UPDATE \| \Q$table_name\E \| $/m,
	    "no header line has an empty key value" );
};


# Check that before_log_event is passed the operation of each action that is logged.

subtest 'before_log_event' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six')");
    
    my @operations;
    
    no warnings 'redefine';
    
    local *ETBasicTest::before_log_event = sub {
	my ($edt, $action, $operation, $table_specifier) = @_;
	push @operations, "$operation $table_specifier";
    };
    
    with_logging( sub {
	
	my $edt = ok_new_edt;
	
	$edt->insert_record('EDT_TEST', { string_req => 'logged insert' });
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'logged update' });
	$edt->replace_record('EDT_TEST', { test_no => 5, string_req => 'logged replace' });
	$edt->delete_record('EDT_TEST', 6);
	
	ok_commit;
    });
    
    is_deeply( \@operations, [ 'insert EDT_TEST', 'update EDT_TEST', 'replace EDT_TEST',
			       'delete EDT_TEST' ],
	       "before_log_event is passed the operation of each action" );
};


# Execute the specified code with the log file name set to the specified name in a
# temporary directory, and LOG_ALL_TABLES set to the specified value. Return a list of
# the files that were written, and the combined contents of those files.

sub with_log_settings {
    
    my ($filename, $log_all, $code) = @_;
    
    my $logdir = tempdir(CLEANUP => 1);
    
    my $save_filename = ETBasicTest->log_filename;
    my $save_all = ETBasicTest->log_all_tables;
    
    ETBasicTest->log_filename("$logdir/$filename");
    ETBasicTest->log_all_tables($log_all);
    
    eval { $code->() };
    my $error = $@;
    
    ETBasicTest->log_filename($save_filename);
    ETBasicTest->log_all_tables($save_all);
    
    die $error if $error;
    
    my @files = map { s{^.*/}{}r } glob("$logdir/*");
    my $log = '';
    
    foreach my $file ( glob("$logdir/*") )
    {
	if ( open(my $fh, '<', $file) )
	{
	    local $/;
	    $log .= <$fh>;
	}
    }
    
    return (\@files, $log);
}


# Set or clear a property of EDT_TEST, and clear the table cache so that the change
# takes effect.

sub set_test_property {
    
    my ($property, $value) = @_;
    
    set_table_property(EDT_TEST => $property => $value);
    ETBasicTest->clear_table_cache('EDT_TEST');
}


# Check which transactions and tables are logged.

subtest 'what is logged' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five'), (6, 'six')");
    
    my ($files, $log) = with_log_settings('test.log', 0, sub {
	my $edt = ok_new_edt;
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'not logged' });
	ok_commit;
    });
    
    is_deeply( $files, [ ], "nothing is logged without LOG_ALL_TABLES or LOG_CHANGES" );
    
    set_test_property(LOG_CHANGES => 1);
    
    ($files, $log) = with_log_settings('test.log', 0, sub {
	my $edt = ok_new_edt;
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'logged by property' });
	ok_commit;
    });
    
    set_test_property(LOG_CHANGES => 0);
    
    like( $log, qr/logged by property/, "a table with LOG_CHANGES is logged" );
    
    ($files, $log) = with_log_settings('test.log', 1, sub {
	my $edt = ok_new_edt;
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'failed transaction' });
	$edt->insert_record('EDT_TEST', { string_req => 'bad', signed_val => 'not a number' });
	ok_failed_commit;
    });
    
    is_deeply( $files, [ ], "a failed transaction writes nothing to the log" );
    
    ($files, $log) = with_log_settings('test-DATE.log', 1, sub {
	my $edt = ok_new_edt;
	$edt->replace_record('EDT_TEST', { test_no => 6, string_req => 'logged replace' });
	ok_commit;
    });
    
    my ($sec, $min, $hour, $mday, $mon, $year) = localtime(time);
    my $date = sprintf("%04d-%02d-%02d", $year + 1900, $mon + 1, $mday);
    
    is_deeply( $files, [ "test-$date.log" ], "DATE in the log file name is replaced by the date" );
    
    like( $log, qr/^# [^|]+ \| REPLACE \| \Q$TABLE{EDT_TEST}\E \| 6$/m, "replace header" );
    like( $log, qr/^REPLACE INTO .*\n.*logged replace/m, "replace statement" );
};


# Check the ways of turning logging off.

subtest 'turning logging off' => sub {
    
    clear_table('EDT_TEST');
    
    sql_command("INSERT INTO <<EDT_TEST>> (test_no, string_req) VALUES (5, 'five')");
    
    my ($files, $log) = with_log_settings('test.log', 1, sub {
	my $edt = ok_new_edt('NO_LOG_MODE');
	ok( $edt->allows('NO_LOG_MODE'), "NO_LOG_MODE is accepted as an allowance" );
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'no log mode' });
	ok_commit;
    });
    
    is_deeply( $files, [ ], "NO_LOG_MODE prevents logging" );
    
    ok( eval { set_test_property(NO_LOG => 1); 1 }, "NO_LOG can be set on a table" );
    
    ($files, $log) = with_log_settings('test.log', 1, sub {
	my $edt = ok_new_edt;
	$edt->update_record('EDT_TEST', { test_no => 5, string_req => 'no log table' });
	ok_commit;
    });
    
    set_test_property(NO_LOG => 0);
    
    is_deeply( $files, [ ], "a table with NO_LOG is not logged even with LOG_ALL_TABLES" );
};
